# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true

# Matches multiple files with brace expansion notation
# Set default charset
[*.{cpp,hpp,c,h,json,lua,sh}]
charset = utf-8

# 4 space indentation
[*.{lua,json}]
indent_style = space
indent_size = 4

# Tab indentation
[*.{cpp,hpp,c,h,sh}]
indent_style = tab
ident_size = 4
